---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['social-links', className]}>
	<a href="https://www.linkedin.com/in/nilsingwersen" target="_blank" rel="noopener">
		<span class="sr-only">Nils on LinkedIn</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
			<path
				fill="currentColor"
				d="M0 1.15C0 .52.52 0 1.17 0h13.66C15.48 0 16 .52 16 1.15v13.7c0 .63-.52 1.15-1.17 1.15H1.17C.52 16 0 15.48 0 14.85zm4.94 12.24V6.17H2.54v7.22zM3.74 5.18c.84 0 1.36-.55 1.36-1.25-.01-.71-.52-1.25-1.34-1.25-.83 0-1.36.54-1.36 1.25 0 .7.52 1.25 1.33 1.25zm4.9 8.21V9.36c0-.22.02-.43.08-.58.17-.43.57-.88 1.23-.88.87 0 1.22.66 1.22 1.64v3.85h2.4V9.25c0-2.22-1.18-3.25-2.76-3.25-1.27 0-1.84.7-2.16 1.19v.03h-.02l.02-.03V6.17h-2.4c.03.68 0 7.22 0 7.22z"
			></path>
		</svg>
	</a>
	<a href="https://github.com/nilsingwersen" target="_blank" rel="noopener">
		<span class="sr-only">Nils on GitHub</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
			<path
				fill="currentColor"
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
			></path>
		</svg>
	</a>
	<a href="https://x.com/nilsingwersen" target="_blank" rel="noopener">
		<span class="sr-only">Nils on X</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
			<path
				fill="currentColor"
				d="M12.6.75h2.45L9.7 6.87 16 15.25h-4.93l-3.86-5.05-4.42 5.05H.34l5.73-6.55L0 .75h5.06l3.49 4.62zm-.86 13.03h1.36L4.32 2.15H2.87z"
			></path>
		</svg>
	</a>
</div>
<style>
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.social-links a {
		display: flex;
		padding: 0.5em;
		border-radius: 8px;
		color: var(--muted);
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}
	.social-links a:hover {
		color: var(--accent);
		background: var(--accent-soft);
	}
</style>
