---
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	<div class="inner">
		<p>&copy; {today.getFullYear()} Nils Ingwersen · Hamburg, Germany</p>
		<SocialLinks />
	</div>
</footer>
<style>
	footer {
		padding: 1.5em;
		border-top: 1px solid var(--line);
		background: var(--surface);
		color: var(--muted);
		font-size: 0.85em;
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5em;
		max-width: 1080px;
		margin: 0 auto;
	}
	p {
		margin: 0;
	}
</style>
